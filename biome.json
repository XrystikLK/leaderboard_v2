{
	"javascript": {
		"experimentalEmbeddedSnippetsEnabled": true
	},
	"html": {
		"experimentalFullSupportEnabled": true
	},
	"overrides": [
		{
			"includes": ["**/*.svelte"],
			"formatter": {
				"enabled": true
			},
			"linter": {
				"enabled": true
			}
		}
	],
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"formatWithErrors": true
	}
}
